rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Bootstrapped Admin: User email from runtime
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'tesfuniguse18@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'
        )
      );
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User account profiles: System roles managed exclusively by Admin
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      // Self-registration: Staff or Viewer for standard users; Admin for Bootstrap Admin or existing Admins
      allow create: if isValidId(userId)
        && request.resource.data.id == userId
        && request.resource.data.keys().hasAll(['id', 'name', 'email', 'role'])
        && request.resource.data.role in ['Admin', 'Staff', 'Viewer']
        && (
          isAdmin() ||
          (isOwner(userId) && request.resource.data.role in ['Staff', 'Viewer'])
        );

      // Only Admins can modify roles. Users can update their own personal info, but role cannot be changed.
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.role == resource.data.role)
      );

      // Only Admins can remove user accounts (cannot delete own account)
      allow delete: if isAdmin() && request.auth.uid != userId;
    }
  }
}
