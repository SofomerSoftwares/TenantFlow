rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'
      );
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User account profiles: System roles managed exclusively by Admin
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      // Self-registration is restricted to Staff or Viewer. Only Admins can provision Admin accounts.
      allow create: if isValidId(userId)
        && request.resource.data.id == userId
        && request.resource.data.keys().hasAll(['id', 'name', 'email', 'role'])
        && request.resource.data.role in ['Admin', 'Staff', 'Viewer']
        && (
          (isOwner(userId) && request.resource.data.role in ['Staff', 'Viewer']) ||
          isAdmin()
        );

      // Only Admins can modify roles. Users can update their own personal info, but role cannot be changed.
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.role == resource.data.role)
      );

      // Only Admins can remove user accounts (cannot delete own account)
      allow delete: if isAdmin() && request.auth.uid != userId;
    }
  }
}
