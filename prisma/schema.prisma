datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  PENDING
  TERMINATED
}

enum ChangeType {
  NEW
  UPDATED
  UNCHANGED
  MISSING
  DUPLICATE
  ERROR
  DEACTIVATED
  REMOVED
}

enum SessionStatus {
  DRAFT
  APPLIED
  DISCARDED
}

model User {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(128)
  email     String   @unique @db.VarChar(191)
  password  String?  @db.VarChar(255)
  role      UserRole @default(STAFF)
  avatar    String?  @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("users")
}

model Tenant {
  id            String       @id @default(uuid()) @db.VarChar(36)
  tenantCode    String       @unique @map("tenant_code") @db.VarChar(64)
  tenantName    String       @map("tenant_name") @db.VarChar(255)
  unit          String       @db.VarChar(64)
  branch        String?      @db.VarChar(128)
  floor         String?      @db.VarChar(64)
  phone         String?      @db.VarChar(64)
  email         String?      @db.VarChar(191)
  status        TenantStatus @default(ACTIVE)
  rent          Decimal?     @db.Decimal(12, 2)
  contractStart DateTime?    @map("contract_start") @db.Date
  contractEnd   DateTime?    @map("contract_end") @db.Date
  category      String?      @db.VarChar(128)
  rawFields     Json?        @map("raw_fields")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  histories     TenantHistory[]

  @@index([tenantCode])
  @@index([status])
  @@index([branch])
  @@index([updatedAt])
  @@map("tenants")
}

model TenantHistory {
  id          String     @id @default(uuid()) @db.VarChar(36)
  tenantCode  String     @map("tenant_code") @db.VarChar(64)
  tenantName  String     @map("tenant_name") @db.VarChar(255)
  field       String     @db.VarChar(128)
  oldValue    String?    @map("old_value") @db.Text
  newValue    String?    @map("new_value") @db.Text
  changeType  ChangeType @default(UPDATED) @map("change_type")
  updatedBy   String     @map("updated_by") @db.VarChar(128)
  updatedDate DateTime   @map("updated_date") @db.Date
  sessionId   String?    @map("session_id") @db.VarChar(64)
  createdAt   DateTime   @default(now()) @map("created_at")

  tenant      Tenant?    @relation(fields: [tenantCode], references: [tenantCode], onDelete: Cascade)
  session     UploadSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantCode])
  @@index([sessionId])
  @@index([updatedDate])
  @@map("tenant_histories")
}

model UploadSession {
  id             String        @id @default(uuid()) @db.VarChar(36)
  masterFileName String        @map("master_file_name") @db.VarChar(255)
  newFileName    String        @map("new_file_name") @db.VarChar(255)
  summary        Json
  appliedAt      DateTime?     @map("applied_at")
  appliedBy      String?       @map("applied_by") @db.VarChar(128)
  status         SessionStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at")

  histories      TenantHistory[]

  @@index([createdAt])
  @@index([status])
  @@map("upload_sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  action    String   @db.VarChar(128)
  details   String   @db.Text
  userName  String   @map("user_name") @db.VarChar(128)
  userRole  String   @map("user_role") @db.VarChar(32)
  userId    String?  @map("user_id") @db.VarChar(36)
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@map("audit_logs")
}

model ColumnMappingConfig {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(128)
  isDefault   Boolean  @default(false) @map("is_default")
  mapping     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("column_mapping_configs")
}
